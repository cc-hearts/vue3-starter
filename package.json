{
  "name": "vue3-starter",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "author": "Carl Chen",
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write .",
    "svg:format": "node --loader ts-node/esm scripts/svg-format.ts"
  },
  "dependencies": {
    "@cc-heart/utils": "^6.0.1",
    "@cc-heart/utils-client": "^2.1.0",
    "@tailwindcss/vite": "^4.1.17",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.555.0",
    "motion-v": "^1.7.4",
    "nprogress": "^0.2.0",
    "reka-ui": "^2.6.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.25",
    "vue-i18n": "^11.2.2",
    "vue-router": "^4.6.3",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@cc-heart/eslint-config": "^3.0.6",
    "@intlify/unplugin-vue-i18n": "^11.0.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^20.19.25",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitejs/plugin-vue-jsx": "^5.1.2",
    "@vitest/coverage-v8": "2.1.2",
    "@vue/test-utils": "^2.4.6",
    "@vueuse/motion": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "husky": "^9.1.7",
    "jsdom": "^27.2.0",
    "lucide-vue-next": "^0.555.0",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "radix-vue": "^1.9.17",
    "sass": "^1.94.2",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "taze": "^19.9.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-svg-component": "^0.12.4",
    "unplugin-vue-router": "^0.18.0",
    "vite": "^7.2.6",
    "vite-plugin-imagemin": "^0.6.1",
    "vite-plugin-pages": "^0.33.2",
    "vite-plugin-progress": "^0.0.7",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-vue-layouts": "^0.11.0",
    "vitest": "^4.0.15",
    "vue-tsc": "^3.1.5",
    "xml-js": "^1.6.11"
  },
  "lint-staged": {
    "*.{vue,js,ts,jsx,tsx,json}": [
      "eslint --fix",
      "prettier --write --cache"
    ],
    "*.md": "prettier --write"
  },
  "packageManager": "pnpm@10.24.0"
}
