{
  "name": "vue3-starter",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "author": "Carl Chen",
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write .",
    "svg:format": "node --loader ts-node/esm scripts/svg-format.ts"
  },
  "dependencies": {
    "@cc-heart/utils": "^5.3.1",
    "@cc-heart/utils-client": "^2.1.0",
    "@tailwindcss/vite": "^4.1.10",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.515.0",
    "nprogress": "^0.2.0",
    "reka-ui": "^2.3.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.10",
    "tw-animate-css": "^1.3.4",
    "vue": "^3.5.12",
    "vue-i18n": "^9.14.1",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@cc-heart/eslint-config": "^3.0.6",
    "@intlify/unplugin-vue-i18n": "^4.0.0",
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^20.16.13",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitejs/plugin-vue-jsx": "^4.0.1",
    "@vitest/coverage-v8": "2.1.2",
    "@vue/test-utils": "^2.4.6",
    "class-variance-authority": "^0.7.1",
    "eslint-plugin-vue": "^9.29.0",
    "husky": "^9.1.6",
    "jsdom": "^25.0.1",
    "lucide-vue-next": "^0.501.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "radix-vue": "^1.9.17",
    "sass": "^1.80.3",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.1.4",
    "taze": "^0.13.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "unplugin-auto-import": "^0.17.8",
    "unplugin-svg-component": "^0.12.1",
    "unplugin-vue-router": "^0.11.2",
    "vite": "^5.4.9",
    "vite-plugin-imagemin": "^0.6.1",
    "vite-plugin-progress": "^0.0.7",
    "vite-plugin-vue-layouts": "^0.11.0",
    "xml-js": "^1.6.11",
    "vite-plugin-pages": "^0.32.3",
    "vite-plugin-svg-icons": "^2.0.1",
    "vitest": "^2.1.3",
    "vue-tsc": "^2.1.6"
  },
  "lint-staged": {
    "*.{vue,js,ts,jsx,tsx,json}": [
      "eslint --fix",
      "prettier --write --cache"
    ],
    "*.md": "prettier --write"
  },
  "packageManager": "pnpm@9.1.3+sha1.6110a47202a78d07d0bf8c9f4f4c63cc83bb833a"
}
